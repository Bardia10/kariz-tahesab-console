# The test database name is server-side and cannot be changed in the browser.
TAHESAB_DATABASE=TahesabDB
# Backend-only credentials. Put the real bearer token in ignored .env, without "Bearer ".
TAHESAB_TOKEN=
CONSOLE_PASSWORD=kariz
SESSION_COOKIE_NAME=tahesab_test_session
# When HTTPS terminates at a reverse proxy, set this to true.
COOKIE_SECURE=auto
APP_ENV=development

